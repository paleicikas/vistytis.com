{
  "expo": {
    "name": "Vištytis",
    "slug": "vistytis",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "vistytis",
    "userInterfaceStyle": "light",
    "icon": "./assets/branding/vistytis-icon.png",
    "splash": {
      "backgroundColor": "#de2119"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Vištyčio aplikacijai reikia vietos leidimo, kad galėtumėte rasti artimiausias vietas ir rinkti ženklelius."
        }
      ],
      "expo-asset",
      [
        "expo-audio",
        {
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-sharing"
    ],
    "android": {
      "package": "com.vistytis.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/vistytis-icon-foreground.png",
        "backgroundColor": "#de2119"
      }
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Vieta naudojama artimiausioms lankytinoms vietoms ir ženklelių rinkimui."
      }
    },
    "web": {
      "bundler": "metro"
    }
  }
}
