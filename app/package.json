{
  "name": "vistytis-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "npm run sync-data && expo start --port 8088",
    "android": "npm run sync-data && node scripts/run-android.mjs --port 8088",
    "ios": "npm run sync-data && expo run:ios --port 8088",
    "web": "npm run sync-data && expo start --web --clear --port 8088",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "sync-data": "node scripts/sync-data.mjs",
    "postinstall": "npm run sync-data"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.2.0",
    "expo": "~55.0.27",
    "expo-asset": "~55.0.8",
    "expo-audio": "~55.0.16",
    "expo-constants": "~55.0.7",
    "expo-font": "~55.0.8",
    "expo-linking": "~55.0.16",
    "expo-location": "~55.1.12",
    "expo-sharing": "~55.0.22",
    "expo-status-bar": "~55.0.4",
    "leaflet": "^1.9.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-maps": "1.27.2",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-view-shot": "4.0.3",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.7.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/leaflet": "^1.9.22",
    "@types/react": "~19.2.10",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-preset-expo": "~55.0.8",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.66.0"
  }
}
